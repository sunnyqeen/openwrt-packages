#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/wstunnel

append_client_redirect() {
	procd_append_param command -L "$1"
}

append_server_redirect() {
	procd_append_param command --restrict-to "$1"
}

append_extra_args() {
	procd_append_param command "$1"
}

start_instance() {
	local cfg="$1"
	local mode="$2"
	local enabled server redirect listen extra_args

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 0 ] && return

	[ -x "$PROG" ] || {
		logger -t wstunnel "Error: $PROG is missing or not executable"
		return 1
	}

	if [ "$mode" = "client" ]; then
		config_get server "$cfg" server

		if [ -z "$server" ]; then
			logger -t wstunnel "Client error ($cfg): 'option server' is required"
			return 1
		fi

		procd_open_instance "$cfg"
		procd_set_param command "$PROG" "$mode" --no-color
		config_list_foreach "$cfg" redirect append_client_redirect
		procd_append_param command "$server"

	elif [ "$mode" = "server" ]; then
		config_get listen "$cfg" listen

		if [ -z "$listen" ]; then
			logger -t wstunnel "Server error ($cfg): 'option listen' is required"
			return 1
		fi

		procd_open_instance "$cfg"
		procd_set_param command "$PROG" "$mode" --no-color
		config_list_foreach "$cfg" redirect append_server_redirect
		procd_append_param command "$listen"
	fi

	config_list_foreach "$cfg" extra_args append_extra_args

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}

	procd_close_instance
}

start_service() {
	config_load wstunnel
	config_foreach start_instance client client
	config_foreach start_instance server server
}

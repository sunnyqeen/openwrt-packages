+
+/// HTML served for regular HTTP requests that are not a websocket upgrade.
+#[derive(Debug, Clone)]
+pub enum HttpFallbackHtml {
+    /// Serve this HTML string as the response body.
+    Inline(String),
+    /// Read and serve this file from disk as the response body.
+    File(PathBuf),
+}
+
+impl HttpFallbackHtml {
+    /// Treat an existing filesystem path as a file to serve; otherwise keep the value as HTML.
+    pub fn from_cli_arg(value: String) -> Self {
+        let path = PathBuf::from(&value);
+        if path.is_file() {
+            Self::File(path)
+        } else {
+            let looks_like_html_file = path.is_absolute()
+                || path
+                    .extension()
+                    .and_then(|ext| ext.to_str())
+                    .is_some_and(|ext| ext.eq_ignore_ascii_case("html") || ext.eq_ignore_ascii_case("htm"));
+            if looks_like_html_file {
+                warn!(
+                    "--http-fallback-html looks like a file path ({}) but the file does not exist; serving the value as an HTML string",
+                    path.display()
+                );
+            }
+            Self::Inline(value)
+        }
+    }
+}
+
+fn html_response(html: String) -> HttpResponse {
+    http::Response::builder()
+        .status(StatusCode::OK)
+        .header(CONTENT_TYPE, "text/html; charset=utf-8")
+        .body(Either::Left(html))
+        .unwrap()
+}
+
+/// Answer a non websocket-upgrade HTTP request: the configured HTML page, or 400 if unset.
+pub(crate) fn non_upgrade_response(fallback: Option<&HttpFallbackHtml>) -> HttpResponse {
+    match fallback {
+        None => bad_request(),
+        Some(HttpFallbackHtml::Inline(html)) => html_response(html.clone()),
+        Some(HttpFallbackHtml::File(path)) => match std::fs::read_to_string(path) {
+            Ok(html) => html_response(html),
+            Err(err) => {
+                warn!("Failed to read HTTP fallback HTML {}: {err}", path.display());
+                bad_request()
+            }
+        },
+    }
 }
 

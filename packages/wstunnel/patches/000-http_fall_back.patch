+#[cfg(test)]
+mod tests {
+    use super::*;
+    use http_body_util::Either;
+
+    #[test]
+    fn non_upgrade_without_option_is_bad_request() {
+        let response = non_upgrade_response(None);
+        assert_eq!(response.status(), StatusCode::BAD_REQUEST);
+        assert!(matches!(response.into_body(), Either::Left(body) if body == "Invalid request"));
+    }
+
+    #[test]
+    fn non_upgrade_inline_html() {
+        let fallback = HttpFallbackHtml::Inline("<html>hi</html>".to_string());
+        let response = non_upgrade_response(Some(&fallback));
+        assert_eq!(response.status(), StatusCode::OK);
+        assert_eq!(response.headers().get(CONTENT_TYPE).unwrap(), "text/html; charset=utf-8");
+        assert!(matches!(response.into_body(), Either::Left(body) if body == "<html>hi</html>"));
+    }
+
+    #[test]
+    fn non_upgrade_file_html() {
+        let path = std::env::temp_dir().join("wstunnel_fallback_test.html");
+        std::fs::write(&path, "<html>from file</html>").unwrap();
+        let fallback = HttpFallbackHtml::File(path.clone());
+        let response = non_upgrade_response(Some(&fallback));
+        let _ = std::fs::remove_file(&path);
+        assert_eq!(response.status(), StatusCode::OK);
+        assert!(matches!(response.into_body(), Either::Left(body) if body == "<html>from file</html>"));
+    }
+
+    #[test]
+    fn from_cli_arg_inline_when_not_a_file() {
+        let parsed = HttpFallbackHtml::from_cli_arg("<h1>ok</h1>".to_string());
+        assert!(matches!(parsed, HttpFallbackHtml::Inline(s) if s == "<h1>ok</h1>"));
+    }
+
+    #[test]
+    fn from_cli_arg_file_when_path_exists() {
+        let path = std::env::temp_dir().join("wstunnel_fallback_cli_test.html");
+        std::fs::write(&path, "x").unwrap();
+        let parsed = HttpFallbackHtml::from_cli_arg(path.to_string_lossy().into_owned());
+        let _ = std::fs::remove_file(&path);
+        assert!(matches!(parsed, HttpFallbackHtml::File(p) if p == path));
+    }
+
+    #[test]
+    fn missing_fallback_file_is_bad_request() {
+        let fallback = HttpFallbackHtml::File(PathBuf::from("this-wstunnel-fallback-file-does-not-exist.html"));
+        let response = non_upgrade_response(Some(&fallback));
+        assert_eq!(response.status(), StatusCode::BAD_REQUEST);
+    }
+}

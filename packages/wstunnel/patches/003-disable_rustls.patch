 /// Encode ALPN protocols in the length-prefixed wire format BoringSSL expects.
+fn system_ca_verify_store() -> anyhow::Result<Option<boring::x509::store::X509Store>> {
+    let ders = crate::tunnel::ca_reloader::get_system_ca_ders();
+    if ders.is_empty() {
+        return Ok(None);
+    }
+
+    let mut store = X509StoreBuilder::new()?;
+    let mut added = 0usize;
+    for der in ders.iter() {
+        match X509::from_der(der) {
+            Ok(cert) => {
+                if store.add_cert(cert).is_ok() {
+                    added += 1;
+                }
+            }
+            Err(err) => warn!("cannot parse a system CA certificate: {err}"),
+        }
+    }
+    if added == 0 {
+        return Ok(None);
+    }
+    Ok(Some(store.build()))
+}

     Ok(Some(store.build()))
 }
 
+/// Chrome's TLS 1.2 cipher list (order matters). TLS 1.3 suites stay on BoringSSL's default,
+/// which matches Chrome: AES-128-GCM, AES-256-GCM, ChaCha20-Poly1305.
+const CHROME_CIPHER_LIST: &str = "\
+ECDHE-ECDSA-AES128-GCM-SHA256:\
+ECDHE-RSA-AES128-GCM-SHA256:\
+ECDHE-ECDSA-AES256-GCM-SHA384:\
+ECDHE-RSA-AES256-GCM-SHA384:\
+ECDHE-ECDSA-CHACHA20-POLY1305:\
+ECDHE-RSA-CHACHA20-POLY1305:\
+ECDHE-RSA-AES128-SHA:\
+ECDHE-RSA-AES256-SHA:\
+AES128-GCM-SHA256:\
+AES256-GCM-SHA384:\
+AES128-SHA:\
+AES256-SHA";
+
+/// Chrome signature_algorithms (no Ed25519).
+const CHROME_SIGALGS: &str = "\
+ecdsa_secp256r1_sha256:\
+rsa_pss_rsae_sha256:\
+rsa_pkcs1_sha256:\
+ecdsa_secp384r1_sha384:\
+rsa_pss_rsae_sha384:\
+rsa_pkcs1_sha384:\
+rsa_pss_rsae_sha512:\
+rsa_pkcs1_sha512";
+
+const CHROME_GROUPS: &str = "X25519MLKEM768:X25519:P-256:P-384";
+const CHROME_GROUPS_NO_MLKEM: &str = "X25519:P-256:P-384";
+
+/// Shape the TCP ClientHello like current Chrome (ciphers, groups, GREASE, OCSP/SCT).
+fn apply_chrome_clienthello(builder: &mut SslConnectorBuilder) -> anyhow::Result<()> {
+    builder
+        .set_min_proto_version(Some(SslVersion::TLS1_2))
+        .with_context(|| "Cannot set TLS min version")?;
+    builder
+        .set_max_proto_version(Some(SslVersion::TLS1_3))
+        .with_context(|| "Cannot set TLS max version")?;
+    builder
+        .set_cipher_list(CHROME_CIPHER_LIST)
+        .with_context(|| "Cannot set Chrome TLS cipher list")?;
+    if builder.set_curves_list(CHROME_GROUPS).is_err() {
+        builder
+            .set_curves_list(CHROME_GROUPS_NO_MLKEM)
+            .with_context(|| "Cannot set Chrome TLS groups")?;
+    }
+    builder
+        .set_sigalgs_list(CHROME_SIGALGS)
+        .with_context(|| "Cannot set Chrome TLS signature algorithms")?;
+    builder.set_grease_enabled(true);
+    builder.set_permute_extensions(true);
+    builder.enable_ocsp_stapling();
+    builder.enable_signed_cert_timestamps();
+    Ok(())
+}
+
 fn encode_alpn(protocols: &[Vec<u8>]) -> Vec<u8> {
     let mut out = Vec::new();
     for proto in protocols {
@@ -161,6 +217,7 @@ pub fn tls_connector(

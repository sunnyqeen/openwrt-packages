+/// Pick a server protocol from the client's ALPN list so the returned slice
+/// borrows `client` (required by BoringSSL's select callback).
+fn select_alpn_from_client<'a>(offered: &[Vec<u8>], client: &'a [u8]) -> Result<&'a [u8], AlpnError> {
+    let mut rest = client;
+    while let Some((&len, tail)) = rest.split_first() {
+        let len = usize::from(len);
+        if tail.len() < len {
+            break;
+        }
+        let (proto, tail) = tail.split_at(len);
+        if offered.iter().any(|offered| offered.as_slice() == proto) {
+            return Ok(proto);
+        }
+        rest = tail;
     }
+    Err(AlpnError::NOACK)
+}
 
